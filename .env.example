# Copy this file to .env and fill in the values you need.
# Every variable here is OPTIONAL — the app runs fully offline without a .env file.

# Port for the combined Express + Vite dev server (default: 3000)
PORT=3000

# Google Gemini API key (optional).
# Get one from https://aistudio.google.com/app/apikey
# Used SERVER-SIDE ONLY. Never prefix it with VITE_ (that would expose it to the browser).
# When absent, the built-in offline EvaluationEngine + question bank are used instead.
GEMINI_API_KEY=

# Node environment: development | production
NODE_ENV=development
